---
import SectionTitle from "../ui/SectionTitle.astro";
import ServiceCard from "../ui/ServiceCard.astro";
import Section from "./Section.astro";

/** 
 * TO - DO
 * 1. Update card pictures
 * 2. Update card links
 * **/

import c1 from "../../assets/pics/card-pic1.png";
import c2 from "../../assets/pics/card-pic2.png";
import c3 from "../../assets/pics/card-pic3.png";
import c4 from "../../assets/pics/card-pic4.png";
import c5 from "../../assets/pics/card-pic5.png";
import c6 from "../../assets/pics/card-pic6.png";

const cards = [
  {
    index: 1,
    titleTop: "Custom Software",
    titleBottom: "Development",
    img: c1,
    alt: "Custom Software Development",
    link: "#contact",
  },
  {
    index: 2,
    titleTop: "Process",
    titleBottom: "Automation",
    img: c2,
    alt: "Process Automation",
    link: "#contact",
  },
  {
    index: 3,
    titleTop: "System",
    titleBottom: "Integration",
    img: c3,
    alt: "System Integration",
    link: "#contact",
  },
  {
    index: 1,
    titleTop: "Cloud",
    titleBottom: "Solutions",
    img: c4,
    alt: "Cloud Solutions",
    link: "#contact",
  },
  {
    index: 2,
    titleTop: "Analytics and",
    titleBottom: "Tracking",
    img: c5,
    alt: "Analytics and Tracking",
    link: "#contact",
  },
  {
    index: 3,
    titleTop: "AI-Ready",
    titleBottom: "Solutions",
    img: c6,
    alt: "AI-Ready Solutions",
    link: "#contact"
  },
];

const description =
  "At Dire Labs, we offer comprehensive software solutions designed to transform how your business operates. Our services include:";
---

<Section id="services">
  <div class="mt-[140px] mb-5">
    <SectionTitle sectionTitle="Services" description={description} />
    <div class="grid lg:grid-cols-2 lg:grid-rows-3 gap-10">
      {
        cards.map((card) => (
          <ServiceCard
            index={card.index}
            titleTop={card.titleTop}
            titleBottom={card.titleBottom}
            img={card.img}
            alt={card.alt}
            link={card.link}
          />
        ))
      }
    </div>
  </div>
</Section>
